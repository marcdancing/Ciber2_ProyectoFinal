extends ../layout3

block content
  .chat-page
    .chat-container.small
      .chat-header
        h1.chat-title= title
        a.chat-link(href='/auth3/login') Volver al login

      .chat-body
        if error
          .error-box= error

        if success
          .success-box= success

        .danger-panel
          h2 Recuperación segura de contraseña
          p Introduce tu nombre de usuario o correo electrónico, define una nueva contraseña y confirma la operación con tu código MFA.
          p Este proceso no modifica tu certificado criptográfico ni permite recuperar la passphrase del certificado.

        form#forgotPasswordForm.chat-form(action='/auth3/forgot-password' method='POST')
          input.chat-input(
            type='text'
            name='identifier'
            id='identifier'
            placeholder='Nombre de usuario o correo electrónico'
            required
          )

          input.chat-input(
            type='password'
            name='newPassword'
            id='newPassword'
            placeholder='Nueva contraseña segura'
            required
          )

          input.chat-input(
            type='password'
            name='newPasswordConfirm'
            id='newPasswordConfirm'
            placeholder='Repite la nueva contraseña'
            required
          )

          .policy-message#passwordMessage.hidden
            | La nueva contraseña todavía no cumple la política de seguridad.

          .policy-message#passwordMatchMessage.hidden
            | Las nuevas contraseñas no coinciden.

          .password-policy#passwordPolicy
            p Política de nueva contraseña:
            ul
              li#ruleLength Mínimo 10 caracteres
              li#ruleUpper Al menos una mayúscula
              li#ruleLower Al menos una minúscula
              li#ruleNumber Al menos un número
              li#ruleSymbol Al menos un carácter especial
              li#rulePasswordMatch Las dos nuevas contraseñas deben coincidir

          input.chat-input(
            type='text'
            name='token'
            id='token'
            placeholder='Código MFA'
            autocomplete='one-time-code'
            required
          )

          button#resetPasswordButton.chat-button(type='submit' disabled) Recuperar contraseña

  script.
    const form = document.getElementById('forgotPasswordForm');

    const identifierInput = document.getElementById('identifier');
    const newPasswordInput = document.getElementById('newPassword');
    const newPasswordConfirmInput = document.getElementById('newPasswordConfirm');
    const tokenInput = document.getElementById('token');
    const resetPasswordButton = document.getElementById('resetPasswordButton');

    const passwordMessage = document.getElementById('passwordMessage');
    const passwordMatchMessage = document.getElementById('passwordMatchMessage');

    const ruleLength = document.getElementById('ruleLength');
    const ruleUpper = document.getElementById('ruleUpper');
    const ruleLower = document.getElementById('ruleLower');
    const ruleNumber = document.getElementById('ruleNumber');
    const ruleSymbol = document.getElementById('ruleSymbol');
    const rulePasswordMatch = document.getElementById('rulePasswordMatch');

    function validatePassword(password) {
      return {
        length: password.length >= 10,
        upper: /[A-Z]/.test(password),
        lower: /[a-z]/.test(password),
        number: /\d/.test(password),
        symbol: /[^A-Za-z\d]/.test(password)
      };
    }

    function isPasswordPolicyValid(password) {
      const rules = validatePassword(password);
      return rules.length && rules.upper && rules.lower && rules.number && rules.symbol;
    }

    function arePasswordsMatching() {
      return newPasswordInput.value.length > 0 &&
        newPasswordConfirmInput.value.length > 0 &&
        newPasswordInput.value === newPasswordConfirmInput.value;
    }

    function setRuleState(element, valid) {
      if (!element) return;

      element.classList.remove('rule-ok', 'rule-bad');

      if (valid) {
        element.classList.add('rule-ok');
      } else {
        element.classList.add('rule-bad');
      }
    }

    function showPolicyMessage(element) {
      if (element) {
        element.classList.remove('hidden');
      }
    }

    function hidePolicyMessage(element) {
      if (element) {
        element.classList.add('hidden');
      }
    }

    function updateState() {
      const password = newPasswordInput.value;
      const passwordConfirm = newPasswordConfirmInput.value;

      const rules = validatePassword(password);
      const policyValid = isPasswordPolicyValid(password);
      const passwordsMatch = arePasswordsMatching();

      setRuleState(ruleLength, rules.length);
      setRuleState(ruleUpper, rules.upper);
      setRuleState(ruleLower, rules.lower);
      setRuleState(ruleNumber, rules.number);
      setRuleState(ruleSymbol, rules.symbol);
      setRuleState(rulePasswordMatch, passwordsMatch);

      newPasswordInput.classList.remove('input-danger');
      newPasswordConfirmInput.classList.remove('input-danger');

      if (password.length === 0) {
        hidePolicyMessage(passwordMessage);
      } else if (!policyValid) {
        newPasswordInput.classList.add('input-danger');
        showPolicyMessage(passwordMessage);
      } else {
        hidePolicyMessage(passwordMessage);
      }

      if (passwordConfirm.length === 0) {
        hidePolicyMessage(passwordMatchMessage);
      } else if (!passwordsMatch) {
        newPasswordConfirmInput.classList.add('input-danger');
        showPolicyMessage(passwordMatchMessage);
      } else {
        hidePolicyMessage(passwordMatchMessage);
      }

      const identifierFilled = identifierInput.value.trim().length > 0;
      const tokenFilled = tokenInput.value.trim().length > 0;

      resetPasswordButton.disabled = !(identifierFilled && policyValid && passwordsMatch && tokenFilled);
    }

    identifierInput.addEventListener('input', updateState);
    newPasswordInput.addEventListener('input', updateState);
    newPasswordConfirmInput.addEventListener('input', updateState);
    tokenInput.addEventListener('input', updateState);

    form.addEventListener('submit', e => {
      const password = newPasswordInput.value;

      if (!isPasswordPolicyValid(password)) {
        e.preventDefault();
        newPasswordInput.classList.add('input-danger');
        showPolicyMessage(passwordMessage);
        alert('La nueva contraseña no cumple la política de seguridad.');
        return;
      }

      if (!arePasswordsMatching()) {
        e.preventDefault();
        newPasswordConfirmInput.classList.add('input-danger');
        showPolicyMessage(passwordMatchMessage);
        alert('Las nuevas contraseñas no coinciden.');
        return;
      }
    });

    updateState();