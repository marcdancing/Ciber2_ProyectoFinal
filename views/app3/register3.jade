extends ../layout3

block content
  .chat-page
    .chat-container.small
      .chat-header
        h1.chat-title= title
        a.chat-link(href='/auth3/login') Ir al login

      .chat-body
        if error
          .error-box= error

        form#registerForm.chat-form(action='/auth3/register' method='POST')
          input.chat-input(type='text' name='username' id='username' placeholder='Nombre de usuario' required)
          input.chat-input(type='email' name='email' id='email' placeholder='Correo electrónico' required)

          input.chat-input(
            type='password'
            name='password'
            id='password'
            placeholder='Contraseña segura'
            required
          )

          .policy-message#passwordMessage.hidden
            | La contraseña todavía no cumple la política de seguridad.

          .password-policy#passwordPolicy
            p Política de contraseña:
            ul
              li#ruleLength Mínimo 10 caracteres
              li#ruleUpper Al menos una mayúscula
              li#ruleLower Al menos una minúscula
              li#ruleNumber Al menos un número
              li#ruleSymbol Al menos un carácter especial

          input(type='hidden' name='publicKey' id='publicKey')
          button#registerButton.chat-button(type='submit' disabled) Registrarse

        #certRegisterModal.cert-modal.hidden
          .cert-modal-content
            h2 Generación del certificado criptográfico
            p Para completar el registro se generará tu certificado personal de usuario.
            p Este certificado contiene tu clave privada cifrada y será necesario para operar desde este u otros equipos autorizados.

            ol
              li Introduce una passphrase robusta para proteger el certificado.
              li Pulsa “Generar certificado”.
              li Guarda el archivo descargado en un lugar seguro.
              li Para usar otro equipo, importa este certificado.

            p.cert-warning
              | ⚠️ Si pierdes el certificado o la passphrase, NO podrás recuperar tus mensajes.

            input#certPassphrase(type='password' placeholder='Passphrase segura del certificado')

            .policy-message#passphraseMessage.hidden
              | La passphrase todavía no cumple la política de seguridad.

            .password-policy#passphrasePolicy
              p Política de passphrase:
              ul
                li#passRuleLength Mínimo 12 caracteres
                li#passRuleUpper Al menos una mayúscula
                li#passRuleLower Al menos una minúscula
                li#passRuleNumber Al menos un número
                li#passRuleSymbol Al menos un carácter especial

            button#generateCertButton.chat-button(type='button' disabled) Generar certificado y registrar

  script.
    const registerForm = document.getElementById('registerForm');
    const certModal = document.getElementById('certRegisterModal');
    const generateButton = document.getElementById('generateCertButton');
    const passInput = document.getElementById('certPassphrase');
    const publicKeyInput = document.getElementById('publicKey');
    const usernameInput = document.getElementById('username');
    const passwordInput = document.getElementById('password');
    const registerButton = document.getElementById('registerButton');

    const passwordMessage = document.getElementById('passwordMessage');
    const passphraseMessage = document.getElementById('passphraseMessage');

    const ruleLength = document.getElementById('ruleLength');
    const ruleUpper = document.getElementById('ruleUpper');
    const ruleLower = document.getElementById('ruleLower');
    const ruleNumber = document.getElementById('ruleNumber');
    const ruleSymbol = document.getElementById('ruleSymbol');

    const passRuleLength = document.getElementById('passRuleLength');
    const passRuleUpper = document.getElementById('passRuleUpper');
    const passRuleLower = document.getElementById('passRuleLower');
    const passRuleNumber = document.getElementById('passRuleNumber');
    const passRuleSymbol = document.getElementById('passRuleSymbol');

    let pendingSubmit = false;

    function validatePassword(password) {
      return {
        length: password.length >= 10,
        upper: /[A-Z]/.test(password),
        lower: /[a-z]/.test(password),
        number: /\d/.test(password),
        symbol: /[^A-Za-z\d]/.test(password)
      };
    }

    function isPasswordValid(password) {
      const rules = validatePassword(password);
      return rules.length && rules.upper && rules.lower && rules.number && rules.symbol;
    }

    function validatePassphrase(passphrase) {
      return {
        length: passphrase.length >= 12,
        upper: /[A-Z]/.test(passphrase),
        lower: /[a-z]/.test(passphrase),
        number: /\d/.test(passphrase),
        symbol: /[^A-Za-z\d]/.test(passphrase)
      };
    }

    function isPassphraseValid(passphrase) {
      const rules = validatePassphrase(passphrase);
      return rules.length && rules.upper && rules.lower && rules.number && rules.symbol;
    }

    function setRuleState(element, valid) {
      if (!element) return;

      element.classList.remove('rule-ok', 'rule-bad');

      if (valid) {
        element.classList.add('rule-ok');
      } else {
        element.classList.add('rule-bad');
      }
    }

    function showPolicyMessage(element) {
      if (element) {
        element.classList.remove('hidden');
      }
    }

    function hidePolicyMessage(element) {
      if (element) {
        element.classList.add('hidden');
      }
    }

    function updatePasswordState() {
      const value = passwordInput.value;
      const rules = validatePassword(value);
      const valid = isPasswordValid(value);

      setRuleState(ruleLength, rules.length);
      setRuleState(ruleUpper, rules.upper);
      setRuleState(ruleLower, rules.lower);
      setRuleState(ruleNumber, rules.number);
      setRuleState(ruleSymbol, rules.symbol);

      passwordInput.classList.remove('input-danger');

      if (value.length === 0) {
        hidePolicyMessage(passwordMessage);
      } else if (!valid) {
        passwordInput.classList.add('input-danger');
        showPolicyMessage(passwordMessage);
      } else {
        hidePolicyMessage(passwordMessage);
      }

      registerButton.disabled = !valid;
    }

    function updatePassphraseState() {
      const value = passInput.value;
      const rules = validatePassphrase(value);
      const valid = isPassphraseValid(value);

      setRuleState(passRuleLength, rules.length);
      setRuleState(passRuleUpper, rules.upper);
      setRuleState(passRuleLower, rules.lower);
      setRuleState(passRuleNumber, rules.number);
      setRuleState(passRuleSymbol, rules.symbol);

      passInput.classList.remove('input-danger');

      if (value.length === 0) {
        hidePolicyMessage(passphraseMessage);
      } else if (!valid) {
        passInput.classList.add('input-danger');
        showPolicyMessage(passphraseMessage);
      } else {
        hidePolicyMessage(passphraseMessage);
      }

      generateButton.disabled = !valid;
    }

    if (passwordInput && registerButton) {
      passwordInput.addEventListener('input', updatePasswordState);
      updatePasswordState();
    }

    if (passInput && generateButton) {
      passInput.addEventListener('input', updatePassphraseState);
      updatePassphraseState();
    }

    function showCertModal() {
      certModal.classList.remove('hidden');
      updatePassphraseState();
    }

    function hideCertModal() {
      certModal.classList.add('hidden');
    }

    function strToArrayBuffer(str) {
      return new TextEncoder().encode(str);
    }

    function abToBase64(buffer) {
      const bytes = new Uint8Array(buffer);
      let binary = '';
      bytes.forEach(b => binary += String.fromCharCode(b));
      return btoa(binary);
    }

    async function exportPublicKey(key) {
      const spki = await crypto.subtle.exportKey('spki', key);
      return abToBase64(spki);
    }

    async function exportPrivateKey(key) {
      return crypto.subtle.exportKey('pkcs8', key);
    }

    async function deriveKey(passphrase, salt) {
      const keyMaterial = await crypto.subtle.importKey(
        'raw',
        strToArrayBuffer(passphrase),
        'PBKDF2',
        false,
        ['deriveKey']
      );

      return crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt,
          iterations: 250000,
          hash: 'SHA-256'
        },
        keyMaterial,
        {
          name: 'AES-GCM',
          length: 256
        },
        false,
        ['encrypt']
      );
    }

    async function generateCertificate(username, passphrase) {
      const keyPair = await crypto.subtle.generateKey(
        {
          name: 'RSA-OAEP',
          modulusLength: 2048,
          publicExponent: new Uint8Array([1, 0, 1]),
          hash: 'SHA-256'
        },
        true,
        ['encrypt', 'decrypt']
      );

      const publicKey = await exportPublicKey(keyPair.publicKey);
      const privateKeyRaw = await exportPrivateKey(keyPair.privateKey);

      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));

      const aesKey = await deriveKey(passphrase, salt);

      const encryptedPrivateKey = await crypto.subtle.encrypt(
        { name: 'AES-GCM', iv },
        aesKey,
        privateKeyRaw
      );

      return {
        username,
        publicKey,
        encryptedPrivateKey: abToBase64(encryptedPrivateKey),
        salt: abToBase64(salt.buffer),
        iv: abToBase64(iv.buffer),
        algorithm: 'RSA-OAEP + AES-GCM + PBKDF2',
        createdAt: new Date().toISOString()
      };
    }

    function downloadCertificate(cert) {
      const blob = new Blob([JSON.stringify(cert, null, 2)], {
        type: 'application/x-secmsg-certificate'
      });

      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');

      a.href = url;
      a.download = `certificado-${cert.username}-app3.secmsg`;
      a.style.display = 'none';

      document.body.appendChild(a);
      a.click();

      setTimeout(() => {
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }, 100);
    }

    registerForm.addEventListener('submit', (e) => {
      if (!pendingSubmit) {
        e.preventDefault();

        const password = passwordInput.value;

        if (!isPasswordValid(password)) {
          passwordInput.classList.add('input-danger');
          showPolicyMessage(passwordMessage);
          alert('La contraseña es insegura. Debe tener mínimo 10 caracteres, una mayúscula, una minúscula, un número y un carácter especial.');
          return;
        }

        showCertModal();
      }
    });

    generateButton.addEventListener('click', async (e) => {
      e.preventDefault();

      const passphrase = passInput.value.trim();
      const username = usernameInput.value.trim().toLowerCase();

      if (!isPassphraseValid(passphrase)) {
        passInput.classList.add('input-danger');
        showPolicyMessage(passphraseMessage);
        alert('La passphrase del certificado es insegura. Debe tener mínimo 12 caracteres, una mayúscula, una minúscula, un número y un carácter especial.');
        return;
      }

      try {
        const cert = await generateCertificate(username, passphrase);

        publicKeyInput.value = cert.publicKey;

        downloadCertificate(cert);

        setTimeout(() => {
          pendingSubmit = true;
          hideCertModal();
          registerForm.submit();
        }, 400);

      } catch (err) {
        console.error(err);
        alert('Error generando certificado');
      }
    });